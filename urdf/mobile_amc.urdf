  <!-- icir_cleanroom: the gas sensor plugin resolves this link in Gazebo, so it
       must survive URDF->SDF fixed-joint lumping. Visual only: a collision here
       would sit in front of the bumper. -->
  <link name="gas_sensor_link">
    <visual>
      <geometry>
        <cylinder radius="0.02" length="0.03" />
      </geometry>
      <material name="gas_sensor_color">
        <color rgba="1 .85 .1 1" />
      </material>
    </visual>
    <inertial>
      <mass value="0.02" />
      <inertia ixx="3.75e-06" iyy="3.75e-06" izz="4.0e-06" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="gas_sensor_link_fixed" type="fixed">
    <parent link="base_footprint" />
    <child link="gas_sensor_link" />
    <origin xyz="0 0 .45" rpy="0 0 0" />
  </joint>
  <gazebo reference="gas_sensor_link_fixed">
    <preserveFixedJoint>true</preserveFixedJoint>
    <disableFixedJointLumping>true</disableFixedJointLumping>
  </gazebo>
  <gazebo reference="gas_sensor_link">
    <material>Gazebo/Yellow</material>
  </gazebo>
