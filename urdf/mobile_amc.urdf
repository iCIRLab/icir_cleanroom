      <mass value="0.2" />
      <inertia ixx="0.000128" iyy="0.000128" izz="0.000128" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="caster_front_fixed" type="fixed">
    <parent link="base_footprint" />
    <child link="caster_front" />
    <origin xyz="0.32 0 .04" rpy="0 0 0" />
  </joint>
  <gazebo reference="caster_front">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>
  <link name="caster_rear">
    <visual>
      <geometry>
        <sphere radius="0.04" />
      </geometry>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.04" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2" />
      <inertia ixx="0.000128" iyy="0.000128" izz="0.000128" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="caster_rear_fixed" type="fixed">
    <parent link="base_footprint" />
    <child link="caster_rear" />
    <origin xyz="-0.32 0 .04" rpy="0 0 0" />
  </joint>
  <gazebo reference="caster_rear">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>
  <link name="base_scan">
    <visual>
      <geometry>
        <box size=".10 .10 .05" />
      </geometry>
      <material name="base_scan_color">
        <color rgba=".08 .12 .14 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size=".10 .10 .05" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.15" />
      <inertia ixx="0.00015625000000000003" iyy="0.00015625000000000003" izz="0.00025000000000000006" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="base_scan_fixed" type="fixed">
    <parent link="base_footprint" />
    <child link="base_scan" />
    <origin xyz=".37 0 .36" rpy="0 0 0" />
  </joint>
  <gazebo reference="base_scan">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="base_scan">
    <sensor name="amc_lidar" type="ray">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="amc_lidar_ros" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>base_scan</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin name="amc_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <update_rate>50</update_rate>
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.56</wheel_separation>
      <wheel_diameter>0.2</wheel_diameter>
      <max_wheel_torque>35</max_wheel_torque>
      <max_wheel_acceleration>0.6</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <!-- icir_cleanroom: 1 = world ground truth. The shared launch publishes
           an identity map->odom, so encoder odometry (0) would offset the
           robot in map by its spawn pose. -->
      <odometry_source>1</odometry_source>
    </plugin>
    <!-- icir_cleanroom: publishes /gas_sensor/sensor_pose, which
         gas_environment_node samples for concentration. -->
    <plugin name="gas_sensor_plugin" filename="libgas_sensor_plugin.so">
      <sensor_link_name>gas_sensor_link</sensor_link_name>
      <detector_radius>0.02</detector_radius>
      <sigma>1.5</sigma>
      <update_rate>20.0</update_rate>
    </plugin>
    <plugin name="amc_joint_states" filename="libgazebo_ros_joint_state_publisher.so">
      <update_rate>30</update_rate>
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
    </plugin>
  </gazebo>
</robot>