Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
    - Alpha: 0.65
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: NavigationMap
      Topic: {Depth: 1, Durability Policy: Transient Local, Reliability Policy: Reliable, Value: /map}
    - Alpha: 0.48
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: false
      Name: GaussianGroundTruth
      Topic: {Depth: 1, Durability Policy: Transient Local, Reliability Policy: Reliable, Value: /gas_lrs/ground_truth}
    - Alpha: 0.48
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: GaussianGroundTruthLog
      Topic: {Depth: 1, Durability Policy: Transient Local, Reliability Policy: Reliable, Value: /gas_lrs/ground_truth_log}
    - Alpha: 0.62
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: false
      Name: GMRFEstimateLinear
      Topic: {Depth: 1, Durability Policy: Transient Local, Reliability Policy: Reliable, Value: /gas_lrs/estimate}
    - Alpha: 0.62
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: GMRFEstimateLog
      Topic: {Depth: 1, Durability Policy: Transient Local, Reliability Policy: Reliable, Value: /gas_lrs/estimate_log}
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: LRSTSPRoute
      Line Style: Lines
      Line Width: 0.04
      Color: 255; 220; 0
      Pose Style: None
      Topic: {Depth: 1, Durability Policy: Transient Local, Reliability Policy: Reliable, Value: /gas_lrs/tsp_route}
    - Class: rviz_default_plugins/Marker
      Enabled: false
      Name: SamplingStatus
      Topic: {Depth: 1, Durability Policy: Transient Local, Reliability Policy: Reliable, Value: /gas_lrs/sampling_status}
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: SamplingStatusLog
      Topic: {Depth: 1, Durability Policy: Transient Local, Reliability Policy: Reliable, Value: /gas_lrs/sampling_status_log}
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: GasSource
      Topic: {Depth: 1, Durability Policy: Transient Local, Reliability Policy: Reliable, Value: /gas_lrs/source}
    - Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic: {Depth: 5, Durability Policy: Volatile, Reliability Policy: Reliable, Value: /robot_description}
      Enabled: true
      Name: RobotModel
      Visual Enabled: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Transformation:
    Current: {Class: rviz_default_plugins/TF}
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDown
      Scale: 14
      Target Frame: map
      X: 25
      Y: 25
Window Geometry:
  Height: 900
  Width: 1400
